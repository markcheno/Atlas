{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:watch": "vitest",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:bindings": "node scripts/check-bindings.mjs",
    "check": "pnpm check:rust && pnpm lint && pnpm typecheck && pnpm test",
    "license-report": "node scripts/license-report.mjs",
    "bench": "node scripts/bench.mjs",
    "e2e": "node e2e/smoke.mjs",
    "spike:tools": "node spikes/scripts/fetch-tools.mjs",
    "spike:corpus": "node spikes/scripts/check-corpus.mjs",
    "spike:extract": "node spikes/scripts/run-extraction.mjs",
    "spike:vectors": "node spikes/scripts/run-vectors.mjs",
    "spike:builds": "node spikes/scripts/measure-builds.mjs",
    "spike:licenses": "node scripts/license-report.mjs --spikes"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
